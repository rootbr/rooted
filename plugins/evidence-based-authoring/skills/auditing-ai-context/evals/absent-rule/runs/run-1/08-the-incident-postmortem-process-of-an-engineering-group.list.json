 "deleted": [
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 9,
   "text": "We write postmortems blamelessly."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 9,
   "text": "Contributing factors are described as conditions of the system, its tooling and its processes."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 20,
   "text": "**Incident commander**: ran the response and opens the postmortem document from the template within one business day."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 22,
   "text": "**Review chair**: a senior engineer from the rotating chair rota who runs the Thursday Postmortem Review that week."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 27,
   "text": "The author starts from the shared template."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 27,
   "text": "The template has five parts: summary, impact, timeline, contributing factors and action items."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 29,
   "text": "The timeline is assembled from the incident channel, the paging history and the deploy log."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 29,
   "text": "Each entry has a timestamp in UTC and a source."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 35,
   "text": "Every postmortem is presented by its author at the Thursday Postmortem Review within five business days of the incident."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 35,
   "text": "The review chair and the attendees question the author in the room, and the postmortem is approved when the chair records the decision in the meeting notes."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 35,
   "text": "A postmortem that misses its Thursday slot is carried to the next week and flagged in the group's weekly report."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 37,
   "text": "The author books a slot on the review agenda as soon as the draft exists."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 37,
   "text": "Slots are twenty minutes long, and the agenda holds at most six postmortems per week."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 39,
   "text": "Before the meeting, the author circulates the draft to the attendees by Wednesday noon so that they can read it in advance."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 41,
   "text": "Attendees who cannot come may leave written questions in the draft, and the chair reads them out during the slot."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 48,
   "text": "Draft circulated"
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 48,
   "text": "Wednesday noon before the review"
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 49,
   "text": "Presented and approved"
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 49,
   "text": "5 business days after the incident"
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 52,
   "text": "If the agenda is full, the review chair may add an extra session on Friday morning."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 56,
   "text": "Each action item has one owner, one due date and a link back to the postmortem."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 56,
   "text": "Action items are filed in the owning team's regular backlog and labelled with the incident number."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 68,
   "text": "Postmortems are internal documents."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 68,
   "text": "Data copied from logs is redacted before the draft is circulated to the attendees."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/08-the-incident-postmortem-process-of-an-engineering-group/old.md",
   "line": 70,
   "text": "A postmortem that touches a security incident is shared only with the review chair and the security team until the chair approves wider circulation."
  }
 ],
