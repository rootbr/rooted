  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/06-rate-limiting-at-an-api-gateway/old.md",
   "line": 34,
   "text": "The plan of a key is read from the account service at authentication and cached for five minutes."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/06-rate-limiting-at-an-api-gateway/old.md",
   "line": 36,
   "text": "A change of plan takes effect at the next quota window after the cache entry expires."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/06-rate-limiting-at-an-api-gateway/old.md",
   "line": 40,
   "text": "When a key has used up its quota window, the gateway answers 429 Too Many Requests until the next quota window starts."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/06-rate-limiting-at-an-api-gateway/old.md",
   "line": 40,
   "text": "Every response carries three headers:"
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/06-rate-limiting-at-an-api-gateway/old.md",
   "line": 42,
   "text": "X-RateLimit-Limit, the number of requests the plan allows per quota window."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/06-rate-limiting-at-an-api-gateway/old.md",
   "line": 43,
   "text": "X-RateLimit-Remaining, the requests still left in the current quota window."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/06-rate-limiting-at-an-api-gateway/old.md",
   "line": 44,
   "text": "X-RateLimit-Reset, the Unix time at which the current quota window ends."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/06-rate-limiting-at-an-api-gateway/old.md",
   "line": 46,
   "text": "A rejected response also carries Retry-After, set to the seconds left until the quota window ends."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/06-rate-limiting-at-an-api-gateway/old.md",
   "line": 50,
   "text": "Clients should read X-RateLimit-Reset and pause until that moment once X-RateLimit-Remaining reaches zero."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/06-rate-limiting-at-an-api-gateway/old.md",
   "line": 52,
   "text": "Clients that run batch jobs are advised to spread their work evenly across the minute."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/06-rate-limiting-at-an-api-gateway/old.md",
   "line": 52,
   "text": "A batch that starts at second zero can use the whole quota window in a few seconds and then sit idle for the rest of it."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/06-rate-limiting-at-an-api-gateway/old.md",
   "line": 58,
   "text": "All gateway nodes must keep their clocks synchronised by NTP, because each node computes the start minute of the quota window from its own clock."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/06-rate-limiting-at-an-api-gateway/old.md",
   "line": 60,
   "text": "Dashboards show, per plan, the share of keys that reached their limit in each quota window."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/06-rate-limiting-at-an-api-gateway/old.md",
   "line": 61,
   "text": "An alert fires when more than five percent of Enterprise keys reach their limit in three quota windows in a row."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/06-rate-limiting-at-an-api-gateway/old.md",
   "line": 65,
   "text": "A client can send its whole allowance in the last second of one quota window and the same again in the first second of the next."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/06-rate-limiting-at-an-api-gateway/old.md",
   "line": 65,
   "text": "The backend can then see twice the plan's rate for a short time."
  },
  {
   "file": "plugins/evidence-based-authoring/skills/auditing-ai-context/evals/absent-rule/cases/06-rate-limiting-at-an-api-gateway/old.md",
   "line": 67,
   "text": "We accept this because the burst is bounded by the plan and lasts no more than two seconds."
  }
